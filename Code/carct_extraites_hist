import numpy as np
from scipy.signal import find_peaks

def extract_pitch_features(histogram, fold_base=12):
    # --- SUM ---
    total_sum = np.sum(histogram)

    # --- UP0 ---
    peaks, _ = find_peaks(histogram)
    if len(peaks) > 1:
        # Chercher le pic dominant
        dominant_peak = peaks[np.argmax(histogram[peaks])]
        # Trouver la période dominante entre les pics
        distances = np.abs(peaks - dominant_peak)
        distances = distances[distances != 0]
        if len(distances) > 0:
            up0 = int(np.round(np.mean(distances)))
        else:
            up0 = 0
    else:
        up0 = 0

    # --- FP0 ---
    folded = np.zeros(fold_base)
    for i in range(len(histogram)):
        folded[i % fold_base] += histogram[i]
    fp0 = int(np.argmax(folded))

    # --- IPO1 ---
    folded_peaks, _ = find_peaks(folded)
    if len(folded_peaks) >= 2:
        # Prendre les deux pics les plus élevés
        top2 = folded_peaks[np.argsort(folded[folded_peaks])[-2:]]
        ipo1 = int(np.abs(top2[1] - top2[0]))
    else:
        ipo1 = 0

    return {
        "SUM": total_sum,
        "UP0": up0,
        "FP0": fp0,
        "IPO1": ipo1
    }
