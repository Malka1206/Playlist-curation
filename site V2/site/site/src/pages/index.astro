---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';

// Liste manuelle des pages du dossier (hors index.astro)
const pages = [
  { name: "Blues", path: "/blues.astro" },
  { name: "Classical", path: "/classical.astro" },
  { name: "Country", path: "/country" },
  { name: "Disco", path: "/disco" },
  { name: "Hiphop", path: "/hiphop" },
  { name: "Jazz", path: "/jazz" },
  { name: "Metal", path: "/metal" },
  { name: "Pop", path: "/pop" },
  { name: "Raggae", path: "/raggae" },
  { name: "Rock", path: "/rock" }
