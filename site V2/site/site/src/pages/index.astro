    // Fonction pour afficher 10 liens aléatoires du genre détecté
    function showPlaylist(genre) {
      const genreKey = genre.trim().toLowerCase();
      const genreMap = {
        blues, classique, country, disco, hiphop, jazz, metal, pop, raggae, rock
      };
      const links = genreMap[genreKey];
      const resultDiv = document.getElementById('result');
      if (!links) {
        resultDiv.innerHTML = `Aucune playlist trouvée pour le genre "${genre}".`;
        return;
      }
      // Mélange et sélectionne 10 liens
      const shuffled = links.slice().sort(() => 0.5 - Math.random());
      const selected = shuffled.slice(0, 10);
      // Affiche les vidéos
      resultDiv.innerHTML = selected.map(
        url => `<iframe width="300" height="170" src="${url}" frameborder="0" allowfullscreen style="margin:8px;"></iframe>`
      ).join('');
    }

    // Handler du formulaire pour un seul fichier
    const form = document.getElementById('audio-form');
    const resultDiv = document.getElementById('result');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fileInput = document.getElementById('audio-file');
      if (!fileInput.files.length) {
        resultDiv.textContent = "Veuillez sélectionner un fichier audio.";
        return;
      }
      const formData = new FormData();
      formData.append('audio', fileInput.files[0]);
      resultDiv.textContent = "Analyse en cours...";
      const response = await fetch('http://localhost:8000/analyze', {
        method: 'POST',
        body: formData
      });
      const data = await response.json();
      if (data.result) {
        showPlaylist(data.result);
      } else {
        resultDiv.textContent = "Erreur lors de l'analyse.";
      }
    });

    // Handler du formulaire pour plusieurs fichiers (affiche juste le genre détecté)
    const multiForm = document.getElementById('audios-form');
    const multiInput = document.getElementById('audio-files');
    const multiResultDiv = document.getElementById('results-multi');

    multiForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!multiInput.files.length) {
        multiResultDiv.textContent = "Veuillez sélectionner des fichiers audio.";
        return;
      }
      if (multiInput.files.length > 20) {
        multiResultDiv.textContent = "Veuillez sélectionner au maximum 20 fichiers.";
        return;
      }
      multiResultDiv.textContent = "Analyse en cours...";
      // Regroupe les fichiers par genre
      const genresMap = {};
      for (const file of multiInput.files) {
        const formData = new FormData();
        formData.append('audio', file);
        try {
          const response = await fetch('http://localhost:8000/analyze', {
            method: 'POST',
            body: formData
          });
          const data = await response.json();
          const genre = data.result ? data.result.trim() : "Erreur";
          if (!genresMap[genre]) {
            genresMap[genre] = [];
          }
          genresMap[genre].push(file.name);
        } catch (err) {
          if (!genresMap["Erreur"]) {
            genresMap["Erreur"] = [];
          }
          genresMap["Erreur"].push(file.name);
        }
      }
      // Affiche les résultats regroupés par genre
      let html = '';
      for (const [genre, files] of Object.entries(genresMap)) {
        html += `<div style="margin-bottom:1em;"><b>${genre}</b> :<br>${files.map(f => `<span style="margin-right:8px">${f}</span>`).join('')}</div>`;
      }
      multiResultDiv.innerHTML = html || "Aucun genre détecté.";
    });

    // Permet de soumettre le formulaire quand on sélectionne des fichiers
    document.getElementById('audio-file').addEventListener('change', () => form.requestSubmit());
    document.getElementById('audio-files').addEventListener('change', () => multiForm.requestSubmit());
  </script>
</Layout>