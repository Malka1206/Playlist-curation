 async function getGenresFromDeezer() {
  // Récupère les artistes du genre classique (ID 98)
  const response = await fetch("https://api.deezer.com/genre/464/artists");
  const genrejson = await response.json();
  
  if (genrejson.data && genrejson.data.length > 0) {
    let allTracks = [];
    
    // Prendre les 5 premiers artistes classiques
    const classicalArtists = genrejson.data.slice(0, 10);
    
    // Pour chaque artiste, récupérer ses meilleures chansons
    for (const artist of classicalArtists) {
      try {
        const tracksResponse = await fetch(`https://api.deezer.com/artist/${artist.id}/top?limit=2`);
        const tracksJson = await tracksResponse.json();
        if (tracksJson.data) {
          allTracks.push(...tracksJson.data);
        }
      } catch (error) {
        console.log(`Erreur pour l'artiste ${artist.name}:`, error);
      }
    }
    
    return allTracks;
  }
  return [];
}
const tracks = await getGenresFromDeezer();

---

<html lang="fr">
  <head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Musique metal</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
      background-attachment: fixed;
      color: #fff;
      padding: 2rem;
      max-width: 900px;
      margin: auto;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    /* Fond musical animé */
    body::before {
      content: '♪ ♫ ♪ ♫ ♪ ♫ ♪ ♫ ♪ ♫ ♪ ♫ ♪ ♫ ♪ ♫ ♪ ♫ ♪ ♫';
      position: fixed;
      top: 0;
      left: 0;
      width: 200%;
      height: 100%;
      font-size: 2rem;
      color: rgba(255, 255, 255, 0.1);
      z-index: -1;
      animation: musicFlow 20s linear infinite;
      pointer-events: none;
      line-height: 4rem;
    }

    @keyframes musicFlow {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0%); }
    }

    h1 {
      text-align: center;
      font-size: 3rem;
      font-weight: 700;
      margin-bottom: 3rem;
      color: #fff;
      text-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      background: linear-gradient(45deg, #fff, #f093fb, #fff);
      background-size: 200% 200%;
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: gradientShift 3s ease-in-out infinite;
      position: relative;
    }

    h1::after {
      content: '🎵';
      position: absolute;
      right: -60px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 2rem;
      animation: bounce 2s ease-in-out infinite;
    }

    @keyframes gradientShift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(-50%) rotate(0deg); }
      50% { transform: translateY(-70%) rotate(10deg); }
    }

    ul {
      list-style: none;
      padding: 0;
    }

    li {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
      margin-bottom: 2rem;
      padding: 1.5rem;
      display: grid;
      grid-template-columns: auto 1fr auto auto;
      gap: 1rem;
      align-items: center;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    li::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
      transition: left 0.5s ease;
    }

    li:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
      border-color: rgba(255, 255, 255, 0.4);
    }

    li:hover::before {
      left: 100%;
    }

    .track-info {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    li h3 {
      font-size: 1.3rem;
      font-weight: 600;
      color: #fff;
      margin: 0;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    }

    li p {
      margin: 0;
      font-weight: 300;
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.9rem;
    }

    li img {
      width: 80px;
      height: 80px;
      border-radius: 12px;
      object-fit: cover;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      transition: transform 0.3s ease;
    }

    li:hover img {
      transform: rotate(5deg) scale(1.1);
    }

    /* Bouton de lecture rapide */
    .play-button {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: linear-gradient(45deg, #f093fb, #667eea);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: white;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(240, 147, 251, 0.4);
      position: relative;
      overflow: hidden;
    }

    .play-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.3s ease;
    }

    .play-button:hover {
      transform: scale(1.1);
      box-shadow: 0 6px 20px rgba(240, 147, 251, 0.6);
    }

    .play-button:hover::before {
      left: 100%;
    }

    .play-button:active {
      transform: scale(0.95);
    }

    .play-button.playing {
      background: linear-gradient(45deg, #667eea, #764ba2);
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { 
        box-shadow: 0 4px 15px rgba(240, 147, 251, 0.4);
      }
      50% { 
        box-shadow: 0 4px 25px rgba(240, 147, 251, 0.8);
        transform: scale(1.05);
      }
    }

    audio {
      width: 100%;
      height: 50px;
      border-radius: 25px;
      background: rgba(255, 255, 255, 0.2);
      outline: none;
      border: 2px solid rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(5px);
      cursor: pointer;
      transition: all 0.3s ease;
    }

    audio:hover {
      background: rgba(255, 255, 255, 0.3);
      border-color: rgba(255, 255, 255, 0.5);
      transform: scale(1.02);
    }

    audio:focus {
      outline: 2px solid #f093fb;
      outline-offset: 2px;
    }

    /* Personnalisation des contrôles audio pour Webkit (Chrome, Safari) */
    audio::-webkit-media-controls-panel {
      background: rgba(255, 255, 255, 0.2);
      border-radius: 25px;
      backdrop-filter: blur(5px);
    }

    audio::-webkit-media-controls-play-button {
      background: rgba(255, 255, 255, 0.8);
      border-radius: 50%;
      margin: 5px;
    }

    audio::-webkit-media-controls-timeline {
      background: rgba(255, 255, 255, 0.3);
      border-radius: 10px;
      margin: 0 10px;
    }

    audio::-webkit-media-controls-volume-slider {
      background: rgba(255, 255, 255, 0.3);
      border-radius: 10px;
    }

    /* Animation de pulsation pour les éléments audio */
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    /* Responsive */
    @media (max-width: 768px) {
      li {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 1.5rem;
      }
      
      .play-button {
        justify-self: center;
      }
      
      h1 {
        font-size: 2rem;
      }
      
      h1::after {
        position: static;
        display: block;
        margin-top: 0.5rem;
      }
    }
  </style>
  </head>
  <body>
	<h1>Musique Classique </h1>
	<ul>
		{tracks.map((track: any, index: number) => (
			<li>
				<img src={track.album.cover_small} alt="cover" />
				<div class="track-info">
					<h3>{track.title}</h3>
					<p>{track.artist.name}</p>
					<p>{track.album.title}</p>
				</div>
				<button class="play-button" data-track-id={index}>
					▶
				</button>
				<audio controls="" preload="none" data-audio-id={index}>
					<source src={track.preview} type="audio/mpeg" />
					Your browser does not support the audio element.
				</audio>
			</li>
		))}
	</ul>

	<script is:inline>
		document.addEventListener('DOMContentLoaded', function() {
			const playButtons = document.querySelectorAll('.play-button');
			const audioElements = document.querySelectorAll('audio');
			let currentlyPlaying = null;

			playButtons.forEach((button, index) => {
				button.addEventListener('click', function() {
					const audio = audioElements[index];
					
					// Si une autre piste est en cours de lecture, l'arrêter
					if (currentlyPlaying && currentlyPlaying !== audio) {
						currentlyPlaying.pause();
						currentlyPlaying.currentTime = 0;
						// Remettre tous les boutons à l'état play
						playButtons.forEach(btn => {
							btn.textContent = '▶';
							btn.classList.remove('playing');
						});
					}

					// Basculer lecture/pause pour la piste actuelle
					if (audio.paused) {
						audio.play();
						button.textContent = '⏸';
						button.classList.add('playing');
						currentlyPlaying = audio;
					} else {
						audio.pause();
						button.textContent = '▶';
						button.classList.remove('playing');
						currentlyPlaying = null;
					}
				});
			});

			// Synchroniser les boutons avec les contrôles natifs
			audioElements.forEach((audio, index) => {
				const button = playButtons[index];
				
				audio.addEventListener('play', function() {
					// Arrêter les autres pistes
					audioElements.forEach((otherAudio, otherIndex) => {
						if (otherAudio !== audio && !otherAudio.paused) {
							otherAudio.pause();
							otherAudio.currentTime = 0;
							playButtons[otherIndex].textContent = '▶';
							playButtons[otherIndex].classList.remove('playing');
						}
					});
					
					button.textContent = '⏸';
					button.classList.add('playing');
					currentlyPlaying = audio;
				});

				audio.addEventListener('pause', function() {
					button.textContent = '▶';
					button.classList.remove('playing');
					if (currentlyPlaying === audio) {
						currentlyPlaying = null;
					}
				});

				audio.addEventListener('ended', function() {
					button.textContent = '▶';
					button.classList.remove('playing');
					currentlyPlaying = null;
				});
			});
		});
	</script>
  </body>
</html>