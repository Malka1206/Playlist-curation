  <style>
    body, html {
      height: 100%;
      margin: 0;
      padding: 0;
      /* Ajout de l'image de fond */
      background: url('/tof.jpg') no-repeat center center fixed;
      background-size: cover;
    }
    .container {
      max-width: 600px;
      margin: 3rem auto;
      background: rgba(255,255,255,0.40); /* Opacité réduite */
      border-radius: 12px;
      box-shadow: 0 2px 16px rgba(0,0,0,0.07);
      padding: 2rem 2.5rem;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    h2 {
      margin-top: 0;
      color: #2b2d42;
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -1px;
      text-align: center;
    }
    label {
      font-weight: 500;
      color: #444;
      text-align: center;
      width: 100%;
      display: block;
    }
    form {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    input[type="file"] {
      border: 1px solid #ccc;
      border-radius: 6px;
      padding: 0.5rem;
      width: 100%;
      background: #f8f8f8;
      margin-bottom: 1rem;
      text-align: center;
    }
    button {
      background: #2b2d42;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 0.7rem 1.5rem;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      margin-top: 0.5rem;
      display: block;
    }
    button:hover {
      background: #41506b;
    }
    #result {
      margin-top: 1rem;
      min-height: 2rem;
      color: #222;
      font-size: 1.1rem;
      text-align: center;
      width: 100%;
    }
    /* Hide Astro preview overlay and toolbar */
    [data-astro-dev-toolbar],
    [data-astro-dev-overlay],
    .astro-dev-toolbar {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
      height: 0 !important;
      width: 0 !important;
      opacity: 0 !important;
      position: absolute !important;
      z-index: -9999 !important;
    }

    .dropzone-row {
      display: flex;
      gap: 2rem;
      justify-content: center;
      width: 100%;
    }
    .dropzone-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 320px;
      min-width: 220px;
      background: rgba(255,255,255,0.25);
      border-radius: 10px;
      padding: 1.2rem 1rem 1.5rem 1rem;
      box-shadow: 0 1px 8px rgba(0,0,0,0.05);
    }
    .dz-btn {
      margin-bottom: 0.7rem;
      width: 90%;
      background: #2b2d42;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 0.7rem 1.5rem;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    .dz-btn:hover {
      background: #41506b;
    }
    .dz-label {
      width: 100%;
      text-align: center;
      color: #444;
      font-weight: 500;
      margin-bottom: 0.5rem;
      cursor: pointer;
      display: block;
    }
    #result, #results-multi {
      margin-top: 1rem;
      min-height: 2rem;
      color: #222;
      font-size: 1.1rem;
      text-align: center;
      width: 100%;
    }
    @media (max-width: 900px) {
      .dropzone-row {
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
      }
      .dropzone-col {
        width: 100%;
        min-width: 0;
      }
    }
  </style>

  <div class="container">
    <Welcome />

    <div class="dropzone-row">
      <div class="dropzone-col">
        <button type="button" class="dz-btn" onclick="document.getElementById('audio-file').click()">Analyser un fichier</button>
        <form id="audio-form">
          <input 
            type="file" 
            id="audio-file" 
            name="audio" 
            accept="audio/*"
            style="display:none"
          />
          <label for="audio-file" class="dz-label">
            Déposez un fichier audio ou cliquez pour parcourir
          </label>
        </form>
        <div id="result"></div>
      </div>
      <div class="dropzone-col">
        <button type="button" class="dz-btn" onclick="document.getElementById('audio-files').click()">Analyser plusieurs fichiers</button>
        <form id="audios-form">
          <input 
            type="file" 
            id="audio-files" 
            name="audios" 
            accept="audio/*"
            multiple
            style="display:none"
          />
          <label for="audio-files" class="dz-label">
            Déposez 1 à 20 fichiers audio ou cliquez pour parcourir
          </label>
        </form>
        <div id="results-multi"></div>
      </div>
    </div>
  </div>

